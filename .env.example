# Comma-separated list of product search terms
SEARCH_TERMS=Synology DS220+,Synology DS218+

# JSON map of term -> max buy-now price (EUR), alternatively: term:price,term2:price
PRICE_THRESHOLDS={"Synology DS220+":220,"Synology DS218+":180}

# How often to run checks (minutes)
CHECK_INTERVAL=15

# Comma-separated enabled marketplaces (supported: ebay,kleinanzeigen)
MARKETPLACES=ebay,kleinanzeigen

# Optional: Discord webhook URL for notifications
DISCORD_WEBHOOK_URL=

# SQLite storage path
DB_PATH=data/deal_sniper.db

# Optional custom user agent
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
